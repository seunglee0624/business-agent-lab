/* Double-brace token placeholders are replaced from tokens.json by app/theme.py.
   Regions are told apart by background brightness (base -> panel -> elevated -> highlight), not by lines. */

QWidget {
    font-family: {{font.family}};
    font-size: {{font.size}}px;
    font-weight: {{font.weight}};
}

/* ---- document area */

QGraphicsView#pageView {
    background: {{color.bg_base}};
    border: 2px solid transparent; /* coloured on focus; transparent keeps the layout still */
}

/* large keyboard targets get a quiet grey frame: green around the whole page would shout */
QGraphicsView#pageView:focus,
QTabWidget#sidebar QListView:focus,
QTabWidget#sidebar QTreeView:focus {
    border-color: {{color.outline}};
}

/* ---- toolbars: groups are 8px apart inside, 16px between (separators are gaps, not lines) */

/* the margin is set by type, not #name: Qt reads it while the toolbar is still unnamed.
   8px around a 32px row: the menu bar sits about midway between the title bar and the toolbar icons */
QToolBar {
    spacing: {{spacing.md}}px;
    padding: {{spacing.md}}px;
}

QToolBar#toolbar,
QToolBar#searchBar {
    background: {{color.bg_panel}};
    color: {{color.text}};
    border: none;
    qproperty-iconSize: {{size.control_sm}}px {{size.control_sm}}px; /* icons.py centres the glyph in the button square */
}

/* the dock resize handles: the page's ground, so the panes stand apart without a bar between,
   as wide as the gap at the window's edges */
QMainWindow::separator {
    background: {{color.bg_panel}}; /* the window's frame colour, like the tab row: no dark gaps between panes */
    width: {{spacing.md}}px;
}

QToolBar::separator {
    width: 0px;
    background: transparent;
}

/* round icon buttons: the icon itself turns white on hover and green + filled when checked */
QToolBar QToolButton {
    background: transparent;
    color: {{color.text_muted}};
    border: none;
    border-radius: {{radius.pill_sm}}px;
    padding: 0px;
    min-width: {{size.control_sm}}px;
    min-height: {{size.control_sm}}px;
    max-width: {{size.control_sm}}px;
    max-height: {{size.control_sm}}px;
}

QToolBar QToolButton:hover {
    color: {{color.text}};
}

QToolBar QToolButton:checked {
    color: {{color.accent}};
}

QToolBar QToolButton:pressed {
    background: {{color.bg_highlight}};
}

QToolBar QToolButton:disabled {
    color: {{color.text_disabled}};
}

/* ---- inputs: rounded boxes on the elevated background, outlined so an empty one is still visible */

QLineEdit,
QSpinBox,
QComboBox {
    background: {{color.bg_elevated}};
    color: {{color.text}};
    border: 1px solid {{color.outline}};
    border-radius: {{radius.md}}px;
    padding: 0px {{spacing.lg}}px;
    min-height: {{size.input_sm}}px; /* + the 1px border = control_sm */
    max-height: {{size.input_sm}}px;
    selection-background-color: {{color.outline}};
    selection-color: {{color.text}};
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 2px solid {{color.accent}};
}

/* an input that does not apply now (e.g. the other AI backend's model): its text greys out too */
QLineEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    color: {{color.text_disabled}};
    border-color: {{color.bg_highlight}};
}

/* the text box inside a spin box or editable combo box: the outer pill already draws the frame */
QSpinBox QLineEdit,
QComboBox QLineEdit {
    background: transparent;
    border: none;
    padding: 0px;
    min-height: 0px;
}

QComboBox::drop-down {
    border: none;
    width: {{size.control_sm}}px;
}

QComboBox::down-arrow {
    image: url({{icon:dropdown:color.text_muted}});
    width: {{spacing.xl}}px;
    height: {{spacing.xl}}px;
}

QComboBox QAbstractItemView {
    background: {{color.bg_elevated}};
    border: none;
    selection-background-color: {{color.bg_highlight}};
}

QToolBar#toolbar QComboBox {
    min-width: {{size.zoom_combo}}px;
}

QToolBar#toolbar QSpinBox {
    min-width: {{size.page_input}}px;
    max-width: {{size.page_input}}px; /* text width: + 2 x 12px padding + border = 56px, room for 4 digits */
    qproperty-alignment: AlignCenter;
}

/* page number and zoom ratio: the spec's mono style (Pretendard's digits are already fixed-width) */
QToolBar#toolbar QSpinBox,
QToolBar#toolbar QSpinBox QLineEdit,
QToolBar#toolbar QComboBox,
QToolBar#toolbar QComboBox QLineEdit,
QLabel#pageTotal {
    font-size: {{font.mono_size}}px;
    font-weight: {{font.mono_weight}};
}

/* arrows hidden by zero width: NoButtons plus a styled frame squeezes the number box to 1px */
QSpinBox::up-button,
QSpinBox::down-button,
QSpinBox::up-arrow,
QSpinBox::down-arrow {
    width: 0px;
    border: none;
    image: none;
}

QToolBar#searchBar QLineEdit {
    min-width: {{size.search_input}}px;
    max-width: {{size.search_max}}px;
    min-height: {{size.input_sm}}px; /* + the 1px border = control_sm, like its buttons and the toolbar's boxes */
    max-height: {{size.input_sm}}px;
    padding: 0px {{spacing.lg}}px;
}

QToolBar#searchBar QLabel {
    color: {{color.text_muted}};
    font-size: {{font.caption_size}}px;
    font-weight: {{font.caption_weight}};
}

/* ---- buttons */

QPushButton {
    background: transparent;
    color: {{color.text}};
    border: 1px solid {{color.outline}};
    border-radius: {{radius.md}}px;
    padding: 0px {{spacing.xl}}px;
    min-height: {{size.control_sm}}px;
}

QPushButton:hover {
    border-color: {{color.text}};
}

QPushButton:focus {
    border: 2px solid {{color.accent}};
}

QPushButton:disabled {
    color: {{color.text_disabled}};
    border-color: {{color.bg_highlight}};
}

QPushButton#primary {
    background: {{color.accent}};
    color: {{color.on_accent}};
    font-weight: {{font.heading_weight}};
    border: 2px solid transparent; /* the green shows through; white on focus */
    border-radius: {{radius.md}}px; /* the zoom box's corners, not a pill */
    padding: 0px {{spacing.xxl}}px;
    min-height: {{size.control_md}}px;
}

/* in a dialog the main button sits beside 취소: same height, told apart by its colour.
   The empty window's 파일 열기 keeps the taller size above. */
QDialog QPushButton#primary {
    border: 1px solid transparent;
    min-height: {{size.control_sm}}px;
}

QPushButton#primary:hover {
    background: {{color.accent_hover}};
}

QPushButton#primary:pressed {
    background: {{color.accent_pressed}};
}

QPushButton#primary:focus {
    border-color: {{color.text}};
}

/* ---- document tabs and the sidebar's tabs share one look:
   only the open one is filled and white; the rest are grey text on the bar */

QTabBar#tabBar {
    background: {{color.bg_panel}};
    qproperty-drawBase: 0;
}

QTabBar#tabBar::tab,
QTabWidget#sidebar > QTabBar::tab {
    background: transparent;
    color: {{color.text_muted}};
    border: none;
    border-radius: {{radius.md}}px;
    min-height: {{size.control_sm}}px;
    padding: 0px {{spacing.lg}}px;
    margin: {{spacing.sm}}px 0px {{spacing.sm}}px {{spacing.md}}px;
}

QTabBar#tabBar::tab:hover,
QTabWidget#sidebar > QTabBar::tab:hover {
    background: {{color.bg_elevated}};
    color: {{color.text}};
}

QTabBar#tabBar::tab:selected,
QTabWidget#sidebar > QTabBar::tab:selected {
    background: {{color.bg_highlight}};
    color: {{color.text}};
    font-weight: {{font.heading_weight}};
}

/* keyboard focus on a tab bar: the current tab gets the focus ring */
QTabBar#tabBar::tab:selected:focus,
QTabWidget#sidebar > QTabBar::tab:selected:focus {
    border: 2px solid {{color.accent}};
}

QToolButton#tabClose {
    background: transparent;
    border: none;
    border-radius: {{radius.sm}}px;
    padding: 0px;
}

QToolButton#tabClose:hover {
    background: {{color.bg_highlight}};
}

/* "remove this row" in the quick-question and shortcut editors: a quiet square that lights up like the chat's icon buttons */
QToolButton#rowRemove {
    background: transparent;
    color: {{color.text_muted}};
    border: 2px solid transparent;
    border-radius: {{radius.md}}px;
    padding: 0px;
}

QToolButton#rowRemove:hover {
    background: {{color.bg_elevated}};
}

QToolButton#rowRemove:focus {
    border-color: {{color.accent}};
}

/* ---- sidebar: tabs on top (styled with the document tabs above), then the lists */

QWidget#sidebarInset {
    background: {{color.bg_panel}};
}

QTabWidget#sidebar::pane {
    border: none;
}

QTabWidget#sidebar > QTabBar {
    qproperty-drawBase: 0;
}

QTabWidget#sidebar > QTabBar::tab {
    /* thirds of the default sidebar: (size.sidebar_width - its left inset - 2 gaps, all spacing.md) / 3 */
    width: {{size.sidebar_tab}}px;
    padding: 0px;
}

QTabWidget#sidebar > QTabBar::tab:first {
    margin-left: 0px; /* line up with the list's left edge below */
}

QTabWidget#sidebar QListView,
QTabWidget#sidebar QTreeView {
    background: {{color.bg_panel}};
    color: {{color.text}};
    border: 2px solid transparent;
}

QTabWidget#sidebar QLabel {
    background: {{color.bg_panel}};
    border: none;
    color: {{color.text_muted}};
    padding: {{spacing.md}}px;
}

QTabWidget#sidebar QTreeView {
    qproperty-indentation: {{spacing.xl}};
}

QTreeView::item,
QListView::item {
    border-radius: {{radius.sm}}px;
    padding: {{spacing.sm}}px;
}

QTreeView::item:hover,
QListView::item:hover {
    background: {{color.bg_elevated}};
}

QTreeView::item:selected,
QListView::item:selected {
    background: {{color.bg_highlight}};
    color: {{color.accent}};
}

/* ---- empty state */

QWidget#emptyState {
    background: {{color.bg_base}};
    color: {{color.text}};
}

QLabel#emptyTitle {
    font-size: {{font.title_size}}px;
    font-weight: {{font.title_weight}};
    padding: {{spacing.md}}px;
}

QLabel#heading {
    font-size: {{font.heading_size}}px;
    font-weight: {{font.heading_weight}};
    padding-top: {{spacing.xxl}}px;
}

/* as tall as its rows (up to the max, then it scrolls); no frame until Tab focuses it */
QWidget#emptyState QListView {
    background: {{color.bg_base}};
    border: 1px solid transparent;
    border-radius: {{radius.md}}px;
    padding: {{spacing.sm}}px; /* keeps the hover fill off the rounded corners */
    min-width: {{size.empty_list_width}}px;
    max-height: {{size.empty_list_height}}px;
}

QWidget#emptyState QListView:focus {
    border-color: {{color.text}}; /* Tab reached it: Delete removes the selected file */
}

/* ---- status bar */

QStatusBar#statusBar {
    background: {{color.bg_panel}};
    color: {{color.text_muted}};
    font-size: {{font.caption_size}}px;
}

QStatusBar#statusBar::item {
    border: none;
}

QStatusBar#statusBar QLabel {
    color: {{color.text_muted}};
    font-size: {{font.caption_size}}px;
    font-weight: {{font.caption_weight}};
    padding: 0px {{spacing.md}}px;
}

/* ---- menus and tooltips */

QMenuBar {
    background: {{color.bg_panel}};
    color: {{color.text}};
}

QMenuBar::item {
    padding: {{spacing.xs}}px {{spacing.md}}px; /* thin and even: the text sits centred in its hover box */
    margin-top: {{spacing.sm}}px; /* room under the title bar; a margin, so the hover box stays even around the text */
}

QMenuBar::item:selected {
    background: {{color.bg_elevated}};
    border-radius: {{radius.sm}}px;
}

QMenu {
    background: {{color.bg_elevated}};
    color: {{color.text}};
    border: none;
    padding: {{spacing.sm}}px;
    font-size: {{font.menu_size}}px;
}

QMenu::item {
    padding: {{spacing.sm}}px {{spacing.xl}}px {{spacing.sm}}px {{spacing.md}}px; /* compact rows */
    min-width: {{size.menu_label}}px; /* the label column: Qt puts the shortcut column right after it */
    border-radius: {{radius.sm}}px;
}

QMenu::item:selected {
    background: {{color.bg_highlight}};
}

QMenu::item:disabled {
    color: {{color.text_disabled}};
}

QMenu::separator {
    height: 1px;
    background: {{color.bg_highlight}};
    margin: {{spacing.sm}}px {{spacing.md}}px;
}

QToolTip {
    background: {{color.bg_elevated}};
    color: {{color.text}};
    border: none;
    padding: {{spacing.sm}}px {{spacing.md}}px;
    font-size: {{font.caption_size}}px;
}

/* ---- scrollbars: a thin translucent pill, no arrows, no track */

QScrollBar:vertical,
QScrollBar:horizontal {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    width: {{size.scrollbar}}px;
}

QScrollBar:horizontal {
    height: {{size.scrollbar}}px;
}

QScrollBar::handle {
    background: {{color.scrollbar}};
    border-radius: {{radius.sm}}px;
    min-height: {{size.control_sm}}px;
    min-width: {{size.control_sm}}px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---- dialogs */

QDialog#propertiesDialog {
    min-width: {{size.dialog_width}}px;
}

QLabel#fieldName {
    color: {{color.text_muted}};
}

/* a key two actions share: Qt runs neither, so it is shown as broken */
QLineEdit[conflict="true"] {
    color: {{color.danger}};
}

/* ---- AI chat panel (right dock) */

/* the chat is a rounded card on the page's dark ground, like a window of its own */
QWidget#chatInset,
QWidget#central {
    background: {{color.bg_panel}};
}

QWidget#chatPanel {
    background: {{color.bg_panel}};
    color: {{color.text}};
    border: 1px solid {{color.bg_highlight}};
    border-radius: {{radius.lg}}px;
}

QTextBrowser#chatLog {
    background: {{color.bg_panel}};
    color: {{color.text}};
    border: 2px solid transparent; /* room for the focus ring without moving the text */
}

QTextBrowser#chatLog:focus {
    border-color: {{color.outline}}; /* like the page and the sidebar lists */
}

/* the question box: one rounded box holding the text, the scope menu and send; its border lights up on focus */
QFrame#chatComposer {
    background: {{color.bg_elevated}};
    border: 1px solid {{color.bg_highlight}};
    border-radius: {{radius.lg}}px;
}

QFrame#chatComposer[focused="true"] {
    border-color: {{color.accent}};
}

QPlainTextEdit#chatInput {
    background: transparent;
    color: {{color.text}};
    border: none;
    max-height: {{size.chat_input}}px;
}

QPlainTextEdit#chatInput:disabled {
    color: {{color.text_disabled}};
}

/* the scope picker inside the box: quiet text with a caret, like a model picker */
QPushButton#chatScope {
    background: transparent;
    color: {{color.text_muted}};
    border: 2px solid transparent;
    border-radius: {{radius.md}}px;
    padding: 0px {{spacing.md}}px;
    font-size: {{font.caption_size}}px;
}

QPushButton#chatScope:hover {
    background: {{color.bg_highlight}};
    color: {{color.text}};
}

QPushButton#chatScope:focus {
    border-color: {{color.accent}};
}

QPushButton#chatScope::menu-indicator {
    image: none; /* the caret is the button's own icon, right of the text */
    width: 0px;
}

QLabel#chatGreeting {
    color: {{color.text}};
    font-size: {{font.title_size}}px;
    font-weight: {{font.heading_weight}};
    padding: 0px {{spacing.xl}}px;
}

/* quick questions before the first message: one per row, grey rounded rectangles */
QWidget#chatPanel QPushButton#chip {
    background: {{color.bg_elevated}};
    border: 2px solid transparent;
    font-size: {{font.size}}px;
}

QWidget#chatPanel QPushButton#chip:hover {
    background: {{color.bg_highlight}};
}

QWidget#chatPanel QPushButton#chip:focus {
    border-color: {{color.accent}};
}

QWidget#chatPanel QPushButton#chip:disabled {
    color: {{color.text_disabled}};
}

QLabel#chatNotice {
    color: {{color.text_muted}};
    font-size: {{font.caption_size}}px;
    font-weight: {{font.caption_weight}};
}

QToolButton#chatButton {
    background: transparent;
    color: {{color.text_muted}};
    border: 2px solid transparent;
    border-radius: {{radius.md}}px;
    min-width: {{size.control_sm}}px;
    min-height: {{size.control_sm}}px;
    max-width: {{size.control_sm}}px;
    max-height: {{size.control_sm}}px;
}

QToolButton#chatButton:hover {
    color: {{color.text}};
    background: {{color.bg_elevated}};
}

QToolButton#chatButton:focus {
    border-color: {{color.accent}};
}

QToolButton#chatButton:disabled {
    color: {{color.text_disabled}};
}

QLabel#chatInfo {
    color: {{color.text_muted}};
    font-size: {{font.caption_size}}px;
    font-weight: {{font.caption_weight}};
}

/* quick questions and the AI settings' presets: small rounded rectangles like the inputs */
QPushButton#chip {
    border-radius: {{radius.md}}px;
    padding: 1px {{spacing.lg}}px; /* 1px more each way: as tall as the 2px-bordered icon buttons beside it */
    font-size: {{font.caption_size}}px;
}

/* the AI settings' provider whose address is in use: white */
QPushButton#chip:checked {
    background: {{color.text}};
    color: {{color.on_accent}};
    border-color: {{color.text}};
    font-weight: {{font.heading_weight}};
}

/* the notes tab's filters: the sidebar's tabs again (grey text, the chosen one filled) */
QPushButton#notesFilter {
    background: transparent;
    color: {{color.text_muted}};
    border: 2px solid transparent;
    border-radius: {{radius.md}}px;
    min-height: {{size.control_sm}}px;
    padding: 0px;
}

QPushButton#notesFilter:hover {
    background: {{color.bg_elevated}};
    color: {{color.text}};
}

QPushButton#notesFilter:checked {
    background: {{color.bg_highlight}};
    color: {{color.text}};
    font-weight: {{font.heading_weight}};
}

QPushButton#notesFilter:focus {
    border-color: {{color.accent}};
}

QTabWidget#sidebar QLabel#notesCount {
    color: {{color.text_muted}};
    padding: 0px;
}

/* ---- notes: the bar under selected text or a clicked highlight */

QFrame#noteBar {
    background: {{color.bg_elevated}};
    border: 1px solid {{color.outline}};
    border-radius: {{radius.md}}px;
}

QFrame#noteBar QToolButton {
    color: {{color.text}};
    background: transparent;
    border: none;
    border-radius: {{radius.sm}}px;
    padding: {{spacing.sm}}px {{spacing.md}}px;
}

QFrame#noteBar QToolButton:hover {
    background: {{color.bg_highlight}};
}

/* icon buttons: like the toolbar's, icons.py centres the glyph in the button square */
QFrame#noteBar QToolButton#noteIcon {
    padding: 0px;
    min-width: {{size.control_sm}}px;
    max-width: {{size.control_sm}}px;
    min-height: {{size.control_sm}}px;
    max-height: {{size.control_sm}}px;
    qproperty-iconSize: {{size.control_sm}}px {{size.control_sm}}px;
}

/* colour dots: radius.md is half of size.hl_dot, so they are round */
QFrame#noteBar QToolButton#hlDot {
    min-width: {{size.hl_dot}}px;
    max-width: {{size.hl_dot}}px;
    min-height: {{size.hl_dot}}px;
    max-height: {{size.hl_dot}}px;
    padding: 0px;
    border: 2px solid transparent;
    border-radius: {{radius.md}}px;
}

QFrame#noteBar QToolButton#hlDot[hl="yellow"] { background: {{color.hl_yellow}}; }
QFrame#noteBar QToolButton#hlDot[hl="green"] { background: {{color.hl_green}}; }
QFrame#noteBar QToolButton#hlDot[hl="blue"] { background: {{color.hl_blue}}; }
QFrame#noteBar QToolButton#hlDot[hl="pink"] { background: {{color.hl_pink}}; }

QFrame#noteBar QToolButton#hlDot:hover,
QFrame#noteBar QToolButton#hlDot[current="true"] {
    border-color: {{color.text}};
}

QPlainTextEdit#noteComment {
    background: {{color.bg_base}};
    color: {{color.text}};
    border: 1px solid {{color.outline}};
    border-radius: {{radius.sm}}px;
}

/* the comment and page-note box: the dialogs' green save and outlined cancel, at the bar's small size */
QFrame#noteBar QToolButton#noteSave,
QFrame#noteBar QToolButton#noteCancel {
    border: 1px solid {{color.outline}};
    border-radius: {{radius.md}}px;
    padding: {{spacing.sm}}px {{spacing.lg}}px;
}

QFrame#noteBar QToolButton#noteCancel:hover {
    background: transparent;
    border-color: {{color.text}};
}

QFrame#noteBar QToolButton#noteSave {
    background: {{color.accent}};
    color: {{color.on_accent}};
    font-weight: {{font.heading_weight}};
    border-color: transparent;
}

QFrame#noteBar QToolButton#noteSave:hover {
    background: {{color.accent_hover}};
}

QFrame#noteBar QToolButton#noteSave:pressed {
    background: {{color.accent_pressed}};
}

